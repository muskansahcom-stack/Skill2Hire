# ==========================================
# NEUROFLEX - PRODUCTION ENVIRONMENT CONFIG
# ==========================================

# Active Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Connection (PostgreSQL / Supabase / Neon / Prisma)
# If left blank, NeuroFlex seamlessly falls back to the in-memory/localStorage repository
DATABASE_URL="postgresql://postgres:password@localhost:5432/neuroflex?schema=public"

# Authentication & Session Security
NEXTAUTH_SECRET="neuroflex-super-secret-production-key-change-in-prod"
NEXTAUTH_URL="http://localhost:3000"

# AI Provider Abstraction
# Options: "gemini" | "openai" | "mock" (auto-detected if keys are present)
AI_PROVIDER=gemini

# Google Gemini API Key (Recommended: gemini-2.0-flash / gemini-1.5-flash)
# Free tier key: https://aistudio.google.com/
GEMINI_API_KEY=""

# OpenAI API Key (gpt-4o-mini / gpt-4o)
# Key: https://platform.openai.com/
OPENAI_API_KEY=""
