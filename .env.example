# =============================================================================
# SKILL2HIRE PLATFORM CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env.local and configure your environment-specific secrets.
# NEVER commit .env.local to source control!
# =============================================================================

# Root Administrative Credentials (Used by CLI provisioner / initial setup)
ADMIN_EMAIL=admin@skill2hire.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Cryptographic Session Secrets
JWT_SECRET=your_hmac_sha256_session_secret_key_here
NEXTAUTH_SECRET=your_auth_master_key_here

# Platform Domain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# 1. TRANSACTIONAL EMAIL OTP PROVIDER (Choose ONE Option)
# =============================================================================
# OPTION A: Resend (https://resend.com)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="Skill2Hire <onboarding@resend.dev>"

# OPTION B: Standard SMTP (Gmail App Passwords, Outlook, Brevo, AWS SES)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_digit_app_password
# SMTP_SECURE=false
# EMAIL_FROM="Skill2Hire <your_email@gmail.com>"

# =============================================================================
# 2. SMS OTP PROVIDER (Choose ONE Option)
# =============================================================================
# OPTION A: Twilio SMS
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

# OPTION B: MSG91
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_TEMPLATE_ID=your_dlt_approved_template_id
